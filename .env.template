# Required: Tencent Cloud API credentials with read/list access to the COS bucket.
# Set these in Vercel Environment Variables. Never commit real credentials.
COS_SECRET_ID=
COS_SECRET_KEY=

# These values already have matching defaults in env.ts.
COS_BUCKET_NAME=gallery-1251463330
COS_REGION=ap-tokyo
COS_CUSTOM_DOMAIN=https://images.decision01.com
# Empty scans the whole bucket; use photos/ to restrict to that folder.
COS_PREFIX=

# Optional services; leave unset when unused.
# PG_CONNECTION_STRING=
# GIT_TOKEN=
